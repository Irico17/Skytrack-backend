[Unit]
Description=Skytrack Scheduling Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skytrack
Group=skytrack
WorkingDirectory=/opt/skytrack/backend
EnvironmentFile=/etc/skytrack/backend.env
ExecStart=/bin/sh -c 'exec /usr/bin/java $JAVA_OPTS -jar /opt/skytrack/backend/scheduling-core.jar'
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# 1152M > RSS máximo esperado con Xmx768+MaxMetaspace160 (~1050M). Con el par
# anterior (Xmx1024 / MemoryMax=1300M) el RSS cruzaba el límite durante el
# ciclo 1 con muchos lotes → OOM-kill → reinicio vacío → 404 en el frontend.
MemoryMax=1152M
# 2 cores reales de la VM; 170% deja CPU para MySQL y nginx (100% era 1 core
# y contradecía ActiveProcessorCount=2 del JAVA_OPTS).
CPUQuota=170%
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/skytrack/backend /tmp

[Install]
WantedBy=multi-user.target
