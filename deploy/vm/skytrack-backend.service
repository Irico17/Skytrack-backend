[Unit]
Description=Skytrack Scheduling Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skytrack
Group=skytrack
WorkingDirectory=/opt/skytrack/backend
EnvironmentFile=/etc/skytrack/backend.env
ExecStart=/bin/sh -c 'exec /usr/bin/java $JAVA_OPTS -jar /opt/skytrack/backend/scheduling-core.jar'
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
# 1152M: tope cgroup del proceso Java (NO es nginx). Con 1280M en VM de 2 GB
# el OOM killer del sistema mataba java+mysql. Xmx=768m.
MemoryMax=1152M
# 2 cores reales de la VM; 170% deja CPU para MySQL y nginx (100% era 1 core
# y contradecía ActiveProcessorCount=2 del JAVA_OPTS).
CPUQuota=170%
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/skytrack/backend /tmp

[Install]
WantedBy=multi-user.target
