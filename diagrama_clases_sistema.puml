@startuml Sistema de Planificación de Rutas de Maletas

' ============================================
' CONFIGURACIÓN DE ESTILOS
' ============================================
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho

' ============================================
' PAQUETE: MODEL (Modelo de Dominio)
' ============================================
package "model" #DDFFDD {
    
    class Airport {
        - id: String
        - name: String
        - continent: Continent
        - storageCapacity: int
        - timezone: ZoneId
        + getStorageCapacity(): int
        + getTimezone(): ZoneId
    }
    
    enum Continent {
        AFRICA
        ASIA
        EUROPE
        NORTH_AMERICA
        SOUTH_AMERICA
        OCEANIA
    }
    
    class AirportManager {
        - airports: Map<String, Airport>
        + addAirport(airport: Airport): void
        + getAirport(id: String): Airport
        + getAllAirports(): List<Airport>
    }
    
    class Flight {
        - id: String
        - origin: Airport
        - destination: Airport
        - departureTime: ZonedDateTime
        - arrivalTime: ZonedDateTime
        - capacity: int
        - type: FlightType
        + availableCapacity(assignedBags: int): int
        + getDuration(): Duration
    }
    
    enum FlightType {
        INTRACONTINENTAL
        INTERCONTINENTAL
    }
    
    class FlightPlan {
        - flights: List<Flight>
        - flightsByOrigin: Map<String, List<Flight>>
        + addFlight(flight: Flight): void
        + getFlightsFrom(airportId: String): List<Flight>
        + getAllFlights(): List<Flight>
    }
    
    class ShipmentBatch {
        - id: String
        - clientId: String
        - origin: Airport
        - destination: Airport
        - arrivalTime: ZonedDateTime
        - deadline: ZonedDateTime
        - bagCount: int
        + calculateSLA(): Duration
        + meetsSLA(arrivalTime: ZonedDateTime): boolean
    }
    
    class AssignedRoute {
        - batch: ShipmentBatch
        - flights: List<Flight>
        - storageEvents: List<StorageEvent>
        - finalArrivalTime: ZonedDateTime
        + getStopCount(): int
        + meetsSLA(): boolean
        + getSLASlack(): Duration
        + getTotalTransitTime(): Duration
        + calculateStorageEvents(): List<StorageEvent>
    }
    
    class Solution {
        - routes: List<AssignedRoute>
        - fitness: double
        - evaluated: boolean
        - unroutableBatches: List<ShipmentBatch>
        + addRoute(route: AssignedRoute): void
        + getFitness(): double
        + setFitness(fitness: double): void
        + isEvaluated(): boolean
    }
    
    class StorageEvent {
        - airport: Airport
        - arrivalTime: ZonedDateTime
        - departureTime: ZonedDateTime
        - bagCount: int
        - type: StorageEventType
    }
    
    enum StorageEventType {
        ARRIVAL
        DEPARTURE
        STORAGE
    }
    
    class ShipmentQueue {
        - pendingBatches: Queue<ShipmentBatch>
        + enqueue(batch: ShipmentBatch): void
        + dequeue(): ShipmentBatch
        + getBatchesInWindow(start: ZonedDateTime, end: ZonedDateTime): List<ShipmentBatch>
    }
    
    class ClientRegistry {
        - clients: Map<String, AirlineClient>
        + addClient(client: AirlineClient): void
        + getClient(clientId: String): AirlineClient
        + validateClientExists(clientId: String): boolean
    }
    
    class AirlineClient {
        - id: String
        - name: String
        - contractType: String
    }
}

' ============================================
' PAQUETE: ALGORITHM (Algoritmos de Optimización)
' ============================================
package "algorithm" #FFDDDD {
    
    interface OptimizationAlgorithm {
        + optimize(batches: List<ShipmentBatch>): Solution
        + configure(config: AlgorithmConfig): void
    }
    
    class GeneticAlgorithm {
        - populationSize: int = 50
        - generations: int = 100
        - mutationRate: double = 0.15
        - tournamentSize: int = 4
        - eliteCount: int = 2
        - stagnationLimit: int = 15
        - routeGenerator: RouteGenerator
        - evaluator: SolutionEvaluator
        + optimize(batches: List<ShipmentBatch>): Solution
        + configure(config: AlgorithmConfig): void
        - initializePopulation(batches: List<ShipmentBatch>): List<Solution>
        - evaluatePopulation(population: List<Solution>): void
        - tournamentSelection(population: List<Solution>): Solution
        - crossover(parent1: Solution, parent2: Solution): Solution
        - mutate(solution: Solution, batches: List<ShipmentBatch>): void
    }
    
    class TabuSearch {
        - maxIterations: int = 200
        - tabuTenure: int = 15
        - neighborhoodSize: int = 20
        - routeGenerator: RouteGenerator
        - evaluator: SolutionEvaluator
        + optimize(batches: List<ShipmentBatch>): Solution
        + refine(initialSolution: Solution): Solution
        + replan(currentSolution: Solution, cancelledFlight: Flight, affectedBatches: List<ShipmentBatch>): Solution
        + configure(config: AlgorithmConfig): void
        - generateMove(current: Solution, batches: List<ShipmentBatch>): Move
        - generateRegenerateMove(current: Solution, batches: List<ShipmentBatch>): Move
    }
    
    class AlgorithmConfig {
        - intParams: Map<String, Integer>
        - doubleParams: Map<String, Double>
        + setInt(key: String, value: int): void
        + setDouble(key: String, value: double): void
        + getInt(key: String, defaultValue: int): int
        + getDouble(key: String, defaultValue: double): double
    }
    
    enum AlgorithmType {
        GATS
        TABU_PURE
        + getDisplayName(): String
        + getDescription(): String
    }
}

' ============================================
' PAQUETE: LOGIC (Lógica de Negocio)
' ============================================
package "logic" #DDDDFF {
    
    class RouteGenerator {
        - flightPlan: FlightPlan
        - airportManager: AirportManager
        - MAX_STOPS: int = 3
        + generateFeasibleRoute(batch: ShipmentBatch): AssignedRoute
        + generateFeasibleRoute(batch: ShipmentBatch, allowedFlights: List<Flight>): AssignedRoute
        - findPath(origin: Airport, destination: Airport, deadline: ZonedDateTime): List<Flight>
    }
    
    class SolutionEvaluator {
        - flightPlan: FlightPlan
        - airportManager: AirportManager
        - expectedBatchCount: int
        - PENALTY_UNROUTABLE: double = 10000.0
        - PENALTY_SLA_VIOLATION: double = 5000.0
        - PENALTY_FLIGHT_OVERCAPACITY: double = 1000.0
        - PENALTY_STORAGE_OVERCAPACITY: double = 800.0
        + evaluate(solution: Solution): double
        + setExpectedBatchCount(count: int): void
        + calculateFlightCapacityPenalties(solution: Solution): double
        + calculateStorageCapacityPenalties(solution: Solution): double
    }
}

' ============================================
' PAQUETE: EXECUTION (Ejecución y Simulación)
' ============================================
package "execution" #FFFFDD {
    
    class Scheduler {
        - primaryAlgorithm: OptimizationAlgorithm
        - tabuSearch: TabuSearch
        - algorithmType: AlgorithmType
        - useRefinement: boolean
        - shipmentQueue: ShipmentQueue
        - evaluator: SolutionEvaluator
        - Ta: int
        - Sa: int
        + executePlanningCycle(currentTime: ZonedDateTime): Solution
        + run(startTime: ZonedDateTime, maxCycles: int): Solution
        + getAlgorithmType(): AlgorithmType
    }
    
    class SchedulerFactory {
        + {static} createGATSScheduler(flightPlan: FlightPlan, airportManager: AirportManager, shipmentQueue: ShipmentQueue, Ta: int, Sa: int): Scheduler
        + {static} createTabuScheduler(flightPlan: FlightPlan, airportManager: AirportManager, shipmentQueue: ShipmentQueue, Ta: int, Sa: int): Scheduler
    }
    
    class SimulationController {
        - flightPlan: FlightPlan
        - airportManager: AirportManager
        - clientRegistry: ClientRegistry
        - currentSimulation: SimulationRunner
        - currentStatus: SimulationStatus
        + startSimulation(scenario: ScenarioType, historicalBatches: List<ShipmentBatch>): void
        + stopSimulation(): void
        + pauseSimulation(): void
        + resumeSimulation(): void
        + getStatus(): SimulationStatus
    }
    
    class SimulationRunner {
        - flightPlan: FlightPlan
        - airportManager: AirportManager
        - geneticAlgorithm: GeneticAlgorithm
        - tabuSearch: TabuSearch
        + runSimulation(batches: List<ShipmentBatch>, K: int, startDate: ZonedDateTime): SimulationResult
        - getBatchesForDay(allBatches: List<ShipmentBatch>, date: ZonedDateTime): List<ShipmentBatch>
        - checkIfReplanNeeded(solution: Solution, newBatches: List<ShipmentBatch>): boolean
    }
    
    class Replanner {
        - flightPlan: FlightPlan
        - tabuSearch: TabuSearch
        - validator: RouteValidator
        + replan(currentSolution: Solution, cancelledFlight: Flight): ReplanResult
        - identifyAffectedBatches(solution: Solution, cancelledFlight: Flight): List<ShipmentBatch>
        - findAlternativeFlights(cancelledFlight: Flight): List<Flight>
    }
    
    class ReplanResult {
        - success: boolean
        - updatedSolution: Solution
        - affectedBatchCount: int
        - reroutedBatchCount: int
        - message: String
    }
    
    enum ScenarioType {
        SCENARIO_1
        SCENARIO_2
        SCENARIO_3
        - K: int
        - Ta: int
        - Sa: int
        + getK(): int
        + getTa(): int
        + getSa(): int
    }
    
    class SimulationStatus {
        - running: boolean
        - paused: boolean
        - currentDay: int
        - totalDays: int
        - currentSolution: Solution
        + getSummary(): String
    }
}

' ============================================
' PAQUETE: VALIDATION (Validación)
' ============================================
package "validation" #FFDDFF {
    
    class RouteValidator {
        - airportManager: AirportManager
        + validate(solution: Solution): ValidationReport
        - validateFlightCapacities(solution: Solution, report: ValidationReport): void
        - validateStorageCapacities(solution: Solution, report: ValidationReport): void
    }
    
    class ValidationReport {
        - violations: List<Violation>
        + addViolation(violation: Violation): void
        + isValid(): boolean
        + getViolations(): List<Violation>
    }
    
    class Violation {
        - type: ViolationType
        - message: String
        - severity: String
    }
    
    enum ViolationType {
        FLIGHT_OVERCAPACITY
        STORAGE_OVERCAPACITY
        SLA_VIOLATION
        INVALID_ROUTE
    }
}

' ============================================
' PAQUETE: MONITORING (Monitoreo y Capacidad)
' ============================================
package "monitoring" #DDFFFF {
    
    class CapacityMonitor {
        - flightPlan: FlightPlan
        - airportManager: AirportManager
        + calculateAverageFlightOccupancy(solution: Solution): double
        + calculateStorageOccupancy(solution: Solution): Map<Airport, Double>
        + identifyBottlenecks(solution: Solution): List<Bottleneck>
    }
    
    class CapacityReport {
        - averageFlightOccupancy: double
        - storageOccupancy: Map<Airport, Double>
        - flightOccupancy: Map<Flight, Double>
        - bottlenecks: List<Bottleneck>
    }
    
    class Bottleneck {
        - type: BottleneckType
        - location: String
        - occupancy: double
        - severity: String
        + getDescription(): String
        + isCritical(): boolean
    }
    
    enum BottleneckType {
        FLIGHT_CAPACITY
        STORAGE_CAPACITY
        ROUTE_CONGESTION
    }
    
    class CollapseDetector {
        - collapseThreshold: double = 0.95
        - unserviceableThreshold: double = 0.50
        - capacityMonitor: CapacityMonitor
        + detectCollapse(solution: Solution): CollapseStatus
    }
    
    class CollapseStatus {
        - level: CollapseLevel
        - unroutablePercentage: double
        - averageOccupancy: double
        - message: String
        + isCollapsed(): boolean
        + isCritical(): boolean
        + getSummary(): String
    }
    
    enum CollapseLevel {
        NORMAL
        WARNING
        CRITICAL
        COLLAPSED
    }
    
    class TrafficLightIndicator {
        - greenThreshold: double = 0.70
        - amberThreshold: double = 0.85
        + evaluate(occupancy: double): TrafficLightColor
        + generateReport(solution: Solution, monitor: CapacityMonitor): TrafficLightReport
    }
    
    class TrafficLightReport {
        - overallColor: TrafficLightColor
        - flightColor: TrafficLightColor
        - storageColor: TrafficLightColor
        - message: String
        + getSummary(): String
    }
    
    enum TrafficLightColor {
        GREEN
        AMBER
        RED
    }
}

' ============================================
' PAQUETE: API (REST Controllers)
' ============================================
package "api" #FFEEEE {
    
    class SimulationRestController {
        - simulationService: SimulationService
        + startSimulation(request: SimulationRequestDTO): ResponseEntity
        + stopSimulation(simId: String): ResponseEntity
        + pauseSimulation(simId: String): ResponseEntity
        + resumeSimulation(simId: String): ResponseEntity
        + getStatus(simId: String): ResponseEntity
    }
    
    class CancellationRestController {
        - cancellationService: CancellationService
        + cancelFlight(simId: String, flightId: String, request: CancelFlightRequestDTO): ResponseEntity
    }
    
    class DataRestController {
        - dataLoadingService: DataLoadingService
        + getAirports(): ResponseEntity
        + getFlightStats(): ResponseEntity
        + importData(): ResponseEntity
    }
}

' ============================================
' PAQUETE: SERVICE (Servicios de Aplicación)
' ============================================
package "service" #EEFFEE {
    
    class SimulationService {
        - simulationController: SimulationController
        - dataLoadingService: DataLoadingService
        - activeSimulations: Map<String, SimulationController>
        + startSimulation(scenarioName: String): String
        + stopSimulation(simId: String): void
        + pauseSimulation(simId: String): void
        + resumeSimulation(simId: String): void
        + getStatus(simId: String): SimulationStatusDTO
    }
    
    class CancellationService {
        - activeSimulations: Map<String, SimulationController>
        - replanner: Replanner
        + cancelFlight(simId: String, flightIdBase: String, day: String): ReplanResultDTO
    }
    
    class DataLoadingService {
        - airportUploader: AirportUploader
        - flightPlanUploader: FlightPlanUploader
        - shipmentUploader: ShipmentUploader
        + loadAirports(): List<Airport>
        + createAirportManager(airports: List<Airport>): AirportManager
        + createClientRegistry(airports: List<Airport>): ClientRegistry
        + loadFlightPlan(airportManager: AirportManager): FlightPlan
        + loadShipments(): List<ShipmentBatch>
    }
    
    class MetricsService {
        - activeSimulations: Map<String, SimulationController>
        - trafficLightIndicator: TrafficLightIndicator
        + getSemaphores(simId: String): SemaphoreDTO
    }
}

' ============================================
' PAQUETE: DTO (Data Transfer Objects)
' ============================================
package "api.dto" #EEEEFF {
    
    class SolutionDTO {
        - routes: List<RouteDTO>
        - fitness: double
        - unroutableCount: int
    }
    
    class RouteDTO {
        - batchId: String
        - flights: List<FlightSegmentDTO>
        - arrivalTime: String
        - meetsSLA: boolean
    }
    
    class FlightSegmentDTO {
        - flightId: String
        - origin: String
        - destination: String
        - departureTime: String
        - arrivalTime: String
    }
    
    class SimulationRequestDTO {
        - scenarioType: String
        - algorithmType: String
    }
    
    class SimulationStatusDTO {
        - simId: String
        - running: boolean
        - paused: boolean
        - currentDay: int
        - totalDays: int
    }
    
    class ReplanResultDTO {
        - success: boolean
        - affectedBatchCount: int
        - reroutedBatchCount: int
        - message: String
    }
    
    class SemaphoreDTO {
        - overallColor: String
        - flightColor: String
        - storageColor: String
        - message: String
    }
    
    class DTOMapper {
        + {static} toSolutionDTO(solution: Solution): SolutionDTO
        + {static} toRouteDTO(route: AssignedRoute): RouteDTO
        + {static} toFlightSegmentDTO(flight: Flight): FlightSegmentDTO
    }
}

' ============================================
' RELACIONES PRINCIPALES
' ============================================

' Model relationships
Airport "1" -- "1" Continent
AirportManager "1" o-- "*" Airport
Flight "1" -- "1" FlightType
Flight "*" -- "1" Airport : origin
Flight "*" -- "1" Airport : destination
FlightPlan "1" o-- "*" Flight
ShipmentBatch "*" -- "1" Airport : origin
ShipmentBatch "*" -- "1" Airport : destination
AssignedRoute "1" o-- "1" ShipmentBatch
AssignedRoute "1" o-- "*" Flight
AssignedRoute "1" o-- "*" StorageEvent
StorageEvent "1" -- "1" StorageEventType
Solution "1" o-- "*" AssignedRoute
Solution "1" o-- "*" ShipmentBatch : unroutable
ShipmentQueue "1" o-- "*" ShipmentBatch
ClientRegistry "1" o-- "*" AirlineClient

' Algorithm relationships
OptimizationAlgorithm <|.. GeneticAlgorithm
OptimizationAlgorithm <|.. TabuSearch
GeneticAlgorithm --> AlgorithmConfig
TabuSearch --> AlgorithmConfig
GeneticAlgorithm --> RouteGenerator
GeneticAlgorithm --> SolutionEvaluator
TabuSearch --> RouteGenerator
TabuSearch --> SolutionEvaluator

' Logic relationships
RouteGenerator --> FlightPlan
RouteGenerator --> AirportManager
RouteGenerator ..> AssignedRoute : creates
SolutionEvaluator --> FlightPlan
SolutionEvaluator --> AirportManager
SolutionEvaluator ..> Solution : evaluates

' Execution relationships
Scheduler --> OptimizationAlgorithm
Scheduler --> TabuSearch
Scheduler --> ShipmentQueue
Scheduler --> SolutionEvaluator
Scheduler --> AlgorithmType
SchedulerFactory ..> Scheduler : creates
SimulationController --> FlightPlan
SimulationController --> AirportManager
SimulationController --> ClientRegistry
SimulationController --> SimulationRunner
SimulationController --> SimulationStatus
SimulationRunner --> GeneticAlgorithm
SimulationRunner --> TabuSearch
SimulationRunner --> FlightPlan
SimulationRunner --> AirportManager
Replanner --> FlightPlan
Replanner --> TabuSearch
Replanner --> RouteValidator
Replanner ..> ReplanResult : creates
SimulationController --> ScenarioType

' Validation relationships
RouteValidator --> AirportManager
RouteValidator ..> ValidationReport : creates
ValidationReport "1" o-- "*" Violation
Violation "1" -- "1" ViolationType

' Monitoring relationships
CapacityMonitor --> FlightPlan
CapacityMonitor --> AirportManager
CapacityMonitor ..> CapacityReport : creates
CapacityReport "1" o-- "*" Bottleneck
Bottleneck "1" -- "1" BottleneckType
CollapseDetector --> CapacityMonitor
CollapseDetector ..> CollapseStatus : creates
CollapseStatus "1" -- "1" CollapseLevel
TrafficLightIndicator --> CapacityMonitor
TrafficLightIndicator ..> TrafficLightReport : creates
TrafficLightReport "1" -- "1" TrafficLightColor

' API relationships
SimulationRestController --> SimulationService
CancellationRestController --> CancellationService
DataRestController --> DataLoadingService

' Service relationships
SimulationService --> SimulationController
SimulationService --> DataLoadingService
CancellationService --> SimulationController
CancellationService --> Replanner
MetricsService --> SimulationController
MetricsService --> TrafficLightIndicator

' DTO relationships
DTOMapper ..> SolutionDTO : creates
DTOMapper ..> RouteDTO : creates
DTOMapper ..> FlightSegmentDTO : creates
SolutionDTO "1" o-- "*" RouteDTO
RouteDTO "1" o-- "*" FlightSegmentDTO

@enduml
